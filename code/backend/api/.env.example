# npm run setup cria um token aleatório no arquivo .env local.
API_ACCESS_TOKEN=
HOST=127.0.0.1
PORT=3001
# Caminho relativo ao diretório code/backend/api, usado pelos scripts npm.
DATABASE_URL=file:./data/amadeus.db
LOG_LEVEL=info
OWNER_ID=primary
# Origens exatas, separadas por vírgula. Vazio bloqueia clientes de navegador.
ALLOWED_ORIGINS=
HTTP_REQUESTS_PER_MINUTE=120
CALL_TICKET_TTL_SECONDS=30
MAX_CONNECTIONS=2
# Obrigatórios quando HOST não for loopback. Use certificado válido para o host.
# TLS_CERT_FILE=./certs/server.crt
# TLS_KEY_FILE=./certs/server.key
# Chaves de adaptadores ficam somente no servidor; configurar pelo nome da variável.
# PROVIDER_LLM_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
# Chave dedicada ao extrator de memória gpt-oss-20b.
# GROQ_GPT_OSS_API_KEY=
# Chave Z.ai para o extrator de memória gratuito glm-4.7-flash.
# ZAI_GLM_FLASH=
# MISTRAL_API_KEY=
# OPENROUTER_API_KEY=
# Token Cloudflare com permissão de inferência Workers AI.
# CLOUDFLARE_AI_TOKEN=
# ID da conta Cloudflare (32 caracteres hexadecimais), necessário para configurar Workers AI.
# CLOUDFLARE_ACCOUNT_ID=
# DEEPGRAM_API_KEY=
# CARTESIA_API_KEY=

# Local reference directory; never commit recordings or provider secrets.
VOICE_REFERENCE_DIRECTORY=../assets/voice-profiles/references
# GEMINI_API_KEY=configure-in-your-local-environment
# STT_SERVICE_TOKEN=use-a-separate-random-secret-of-at-least-32-characters
# TTS_SERVICE_TOKEN=use-a-separate-random-secret-of-at-least-32-characters
