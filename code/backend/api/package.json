{
  "name": "@amadeus/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "db:migrate": "node --env-file-if-exists=.env src/migrate.ts",
    "setup": "node scripts/setup.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "fastify": "5.12.5",
    "@fastify/swagger": "9.9.1",
    "fastify-type-provider-zod": "7.0.0",
    "zod": "4.6.5",
    "@libsql/client": "0.18.0",
    "drizzle-orm": "0.45.3"
  },
  "devDependencies": {
    "vitest": "5.0.3",
    "@eslint/js": "10.0.1",
    "eslint": "10.11.0",
    "typescript-eslint": "8.71.0",
    "typescript": "6.0.3",
    "prettier": "3.9.9",
    "@types/node": "24.10.0"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  }
}
