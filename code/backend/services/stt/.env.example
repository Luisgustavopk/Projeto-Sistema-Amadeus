SERVICE_ACCESS_TOKEN=replace-with-a-random-secret-of-at-least-32-characters
STT_MODEL=small
# Compare accuracy and latency on the same recording; 1 is the faster baseline.
STT_BEAM_SIZE=3
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
# For CUDA, set STT_DEVICE=cuda and STT_COMPUTE_TYPE=int8_float16.
# Windows: directory containing cuBLAS/cuDNN DLLs, when not already on PATH.
# STT_CUDA_LIBRARY_DIRECTORY=C:/path/to/torch/lib
