SERVICE_ACCESS_TOKEN=replace-with-a-different-random-secret-of-at-least-32-characters
TTS_ENGINE=qwen-base
TTS_DEVICE=cuda:0
QWEN_CUDA_GRAPHS=true
# Optional: validate/prepare this reference before reporting startup complete.
# QWEN_WARMUP_REFERENCE=amadeus.wav
# Defaults to backend/api/data/models/qwen3-tts-base-1.7b.
# QWEN_MODEL_DIRECTORY=C:/path/to/local/qwen3-tts-base-1.7b
VOICE_REFERENCE_DIRECTORY=../assets/voice-profiles/references
# Chatterbox only. Original model defaults: 0.5 / 0.5 / 0.8.
# These controls do not guarantee naturalness or specific emotions.
TTS_EXAGGERATION=0.3
TTS_CFG_WEIGHT=0.5
TTS_TEMPERATURE=0.65
